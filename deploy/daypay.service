[Unit]
Description=Day Pay HRMS (gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=daypay
Group=daypay
WorkingDirectory=/opt/daypay/app
ExecStart=/opt/daypay/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
