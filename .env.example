# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production
# True only on a developer machine. Production must be False (the default).
DJANGO_DEBUG=False
# Server addresses users type in the browser (LAN IP and/or hostname)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10,hrms.local
# Same addresses with scheme, so form posts are accepted
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.10,http://hrms.local
# Set True only if nginx serves HTTPS with a certificate. Plain-HTTP LAN: False.
DJANGO_HTTPS=False
DJANGO_TIME_ZONE=Asia/Dubai

# Leave empty for SQLite (development). Set for PostgreSQL:
# DATABASE_URL=postgres://hrms:hrms@localhost:5432/hrms
DATABASE_URL=

# Public site URL (used in email notification links)
SITE_URL=http://192.168.1.10

# Email — default prints to console. For SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Day Pay <noreply@daypay.local>
HRMS_EMAIL_NOTIFICATIONS=true
