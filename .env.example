DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,140.245.244.232

# Leave empty for SQLite (development). Set for PostgreSQL:
# DATABASE_URL=postgres://hrms:hrms@localhost:5432/hrms
DATABASE_URL=

# Public site URL (used in email notification links)
SITE_URL=http://127.0.0.1:8000

# Email — default prints to console. For SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Day Pay <noreply@daypay.local>
HRMS_EMAIL_NOTIFICATIONS=true
